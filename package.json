{
  "name": "openai-image-api",
  "version": "2.1.1",
  "description": "OpenAI Image API wrapper - GPT Image 2.5 (Sunburst, Flare), GPT Image 2, and GPT Image 1.x models for Node.js with CLI and streaming",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "type": "module",
  "bin": {
    "openai-img": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "openai": "node dist/cli.js",
    "openai:help": "node dist/cli.js --help",
    "openai:examples": "node dist/cli.js --examples",
    "openai:flare": "node dist/cli.js --flare",
    "openai:sunburst": "node dist/cli.js --sunburst",
    "openai:gpt-image-2": "node dist/cli.js --gpt-image-2",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "openai",
    "gpt-image",
    "gpt-image-2",
    "gpt-image-2.5",
    "gpt-image-2.5-sunburst",
    "gpt-image-2.5-flare",
    "gpt-image-1.5",
    "image-generation",
    "ai-image",
    "text-to-image",
    "image-edit",
    "streaming",
    "partial-images",
    "cli",
    "typescript"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/openai-image-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/openai-image-api/issues"
  },
  "homepage": "https://github.com/aself101/openai-image-api#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
