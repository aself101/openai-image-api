{
  "name": "openai-image-api",
  "version": "3.0.0",
  "description": "Generate and edit images through the OpenAI Image API \u2014 GPT Image 2.5 (Sunburst, Flare), GPT Image 2 and 1.x \u2014 with streaming partial images, an organization image-cost assessment, a CLI, and TypeScript types",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "type": "module",
  "bin": {
    "openai-img": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./cost": {
      "types": "./dist/cost.d.ts",
      "import": "./dist/cost.js"
    },
    "./admin": {
      "types": "./dist/admin-api.d.ts",
      "import": "./dist/admin-api.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:reference": "node scripts/check-reference.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run lint && npm run format:check && npx tsc --noEmit -p tsconfig.test.json && npm run build && npm test",
    "prepublishOnly": "npm run check:release && npm run build",
    "openai": "node dist/cli.js",
    "openai:help": "node dist/cli.js --help",
    "openai:examples": "node dist/cli.js --examples",
    "openai:flare": "node dist/cli.js --flare",
    "openai:sunburst": "node dist/cli.js --sunburst",
    "openai:gpt-image-2": "node dist/cli.js --gpt-image-2",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "openai",
    "gpt-image",
    "gpt-image-2",
    "gpt-image-2.5",
    "gpt-image-2.5-sunburst",
    "gpt-image-2.5-flare",
    "gpt-image-1.5",
    "image-generation",
    "ai-image",
    "text-to-image",
    "image-edit",
    "streaming",
    "partial-images",
    "cli",
    "typescript",
    "cost-assessment",
    "usage-api",
    "admin-api"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/openai-image-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/openai-image-api/issues"
  },
  "homepage": "https://github.com/aself101/openai-image-api#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.10"
  }
}
